# Copy these into Vercel → Project → Settings → Environment Variables.
# Nothing here belongs in the app's client bundle.

# From https://aistudio.google.com/apikey — the free tier needs no card.
GEMINI_API_KEY="paste-your-key-here"

# Firebase projects whose signed-in users may use the bot. Comma-separated,
# taken from .firebaserc in the app repo. A token from any other project is
# rejected with 401.
FIREBASE_PROJECT_IDS="abhl-timesheet,abhl-ahmedabad-branch"

# Sites allowed to call this proxy from a browser. Anything not listed here is
# blocked by CORS. Include localhost so `npm run dev` on the app still works.
ALLOWED_ORIGINS="https://abhl-timesheet.web.app,https://abhl-ahmedabad-branch.web.app,http://localhost:3000"
