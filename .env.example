# TEMPLATE ONLY — this file is committed to git, so never put a real key here.
# Your actual key goes in TWO places, neither of them this file:
#   - Vercel → Project → Settings → Environment Variables  (what production uses)
#   - .env.local in this folder                            (gitignored, for `vercel dev`)

# From https://aistudio.google.com/apikey — the free tier needs no card.
GEMINI_API_KEY="paste-your-key-here"

# The bot's VOICE. From https://dashboard.sarvam.ai — free trial credits, then
# billed per character. Without this the app still works, it just falls back to
# the browser's own robotic voice.
SARVAM_API_KEY="paste-your-key-here"

# Firebase projects whose signed-in users may use the bot. Comma-separated,
# taken from .firebaserc in the app repo. A token from any other project is
# rejected with 401.
FIREBASE_PROJECT_IDS="abhl-timesheet,abhl-ahmedabad-branch"

# Sites allowed to call this proxy from a browser. Anything not listed here is
# blocked by CORS. Include localhost so `npm run dev` on the app still works.
ALLOWED_ORIGINS="https://abhl-timesheet.web.app,https://abhl-ahmedabad-branch.web.app,http://localhost:3000"

# The firm's central Gmail, read (metadata) and sent through /api/gmail.
# 1. console.cloud.google.com → APIs & Services → enable "Gmail API"
# 2. OAuth consent screen: External, publish to "In production" (an app left
#    in Testing expires every refresh token after 7 days)
# 3. Credentials → OAuth client ID → Web application, authorised redirect URI:
#    https://<your-proxy>.vercel.app/api/gmail-setup
# 4. Put the id + secret here, redeploy, open /api/gmail-setup, sign in as the
#    central account, paste the token it prints as GMAIL_REFRESH_TOKEN, redeploy.
GMAIL_CLIENT_ID="paste-client-id.apps.googleusercontent.com"
GMAIL_CLIENT_SECRET="paste-client-secret"
GMAIL_REFRESH_TOKEN="paste-from-/api/gmail-setup"
